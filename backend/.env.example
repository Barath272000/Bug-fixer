NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://bugfixai:bugfixai@localhost:5432/bugfixai?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d
ENCRYPTION_KEY=replace-with-a-random-string-at-least-32-characters

STORAGE_ROOT=./storage
SANDBOX_WORK_ROOT=./sandbox-work
MAX_UPLOAD_BYTES=524288000
SANDBOX_TIMEOUT_MS=300000
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK_MODE=none

GITHUB_API_URL=https://api.github.com
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Optional GitHub App credentials for repository integrations.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# Add at least one provider key before using AI features.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
LOG_LEVEL=info